# WorkTrack local configuration template.
#
#   1. Copy this file to ".env" in the backend folder (same folder as pom.xml).
#   2. Replace every "change-me" value.
#   3. Start the app from that folder. ".env" is git-ignored and must never be committed.
#
# Format: KEY=VALUE, one per line, no quotes, no backslashes.
# Real environment variables override values in this file.

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=worktrack
DB_USERNAME=
DB_PASSWORD=
# PREFERRED is fine locally. Use REQUIRED (or VERIFY_CA) when MySQL is on another host.
DB_SSL_MODE=PREFERRED

# --- Schema management ----------------------------------------------------
# The app creates/upgrades its tables with Flyway on startup, so the database user needs
# CREATE, ALTER, INDEX, SELECT, INSERT, UPDATE, DELETE on the database. For stricter production setups
# run migrations with a separate privileged user (SPRING_FLYWAY_USER / SPRING_FLYWAY_PASSWORD) and give
# DB_USERNAME only SELECT, INSERT, UPDATE, DELETE.
# Hibernate only validates by default. Leave DDL_AUTO unset unless you know why you need to change it.
# DDL_AUTO=validate

# --- Initial administrator ------------------------------------------------
# Used ONCE, on startup, only if no ADMIN account exists. Password must be 12+ characters.
# After the first successful start you may remove these two lines.
WORKTRACK_ADMIN_EMAIL=
WORKTRACK_ADMIN_PASSWORD=
WORKTRACK_ADMIN_NAME=

# --- Web server -----------------------------------------------------------
SERVER_PORT=8080
# Session and CSRF cookies are "Secure" (HTTPS only) by DEFAULT. For plain-HTTP local development keep
# this line as false. In production DELETE this line (or set true) and serve the app over HTTPS.
SESSION_COOKIE_SECURE=false
# Behind a reverse proxy that terminates HTTPS, set to native so the real client IP is used.
# FORWARD_HEADERS_STRATEGY=native

# --- E-mail notifications ---------------------------------------------------------
# "log" (default): NOTHING IS SENT. The app only records that a message would have been sent
#                  (channel LOG in the Email queue, and a loud warning at startup). Fine for development.
# "smtp":          messages are really sent through your SMTP server. MAIL_HOST and a sender are then
#                  required, and the application REFUSES TO START without them.
# Changing any value here needs a restart of the application.
WORKTRACK_MAIL_MODE=smtp
# Public address people type to open WorkTrack. Used for links in e-mails (invitation, leave requests).
# "localhost" only works on this computer; use the real address (https://...) for other people.
WORKTRACK_BASE_URL=http://localhost:8080
# How long an invitation link stays valid, in hours.
# INVITATION_TTL_HOURS=72
#
# Example: Gmail (needs 2-Step Verification and an App Password: https://myaccount.google.com/apppasswords).
# The normal Google password does NOT work. WORKTRACK_MAIL_FROM must be the same Gmail address.
# WORKTRACK_MAIL_MODE=smtp
# WORKTRACK_MAIL_FROM=your.address@gmail.com
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=change-me-16-character-app-password
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_STARTTLS_REQUIRED=true
#
# Other providers: use the host/port they give you; replace the placeholders below.
# WORKTRACK_MAIL_FROM=worktrack@example.com
# WORKTRACK_MAIL_FROM_NAME=WorkTrack
# MAIL_HOST=smtp.example.com

# --- Notification delivery worker (all optional) ---------------------------------
# The worker is on by default. Retries use exponential back-off. Also available: NOTIFICATIONS_POLL_MS, NOTIFICATIONS_MAX_DELAY_MINUTES, NOTIFICATIONS_LEASE_SECONDS, NOTIFICATIONS_BATCH_SIZE.
# NOTIFICATIONS_WORKER_ENABLED=true
# NOTIFICATIONS_MAX_ATTEMPTS=6
# NOTIFICATIONS_BASE_DELAY_SECONDS=60

# --- Export ---------------------------------------------------------------------
# An export larger than this many rows is refused with a clear message before any file is produced.
# EXPORT_MAX_ROWS=50000
